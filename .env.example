# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# If not set, the built-in GBM market simulator is used (recommended for most users).
MASSIVE_API_KEY=

# Optional: Massive API poll interval in seconds. Free tier: 15s. Paid tiers can
# poll faster (2-15s depending on tier). Only relevant when MASSIVE_API_KEY is set.
MASSIVE_POLL_INTERVAL_SECONDS=

# Optional: set to "true" for deterministic mock LLM responses (used by E2E tests).
LLM_MOCK=false
